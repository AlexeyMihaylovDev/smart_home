# Smart Home Dashboard - Environment Configuration
# Copy this file to .env and customize the values

# ============================================
# Default User Credentials
# ============================================
# The dashboard will create this user automatically on first run
# IMPORTANT: Change these default values for security!
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=admin

# ============================================
# Home Assistant Connection (Optional)
# ============================================
# You can pre-configure the Home Assistant connection here,
# or configure it through the dashboard UI after first login

# Home Assistant URL
# Examples:
#   - Local: http://homeassistant.local:8123
#   - IP address: http://192.168.1.100:8123
#   - Docker network: http://homeassistant:8123
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Home Assistant Long-Lived Access Token
# Generate this in Home Assistant:
# Profile -> Security -> Long-Lived Access Tokens -> Create Token
HOME_ASSISTANT_TOKEN=

# ============================================
# Notes
# ============================================
# - The .env file is gitignored for security
# - Environment variables override default values
# - Leave HOME_ASSISTANT_TOKEN empty to configure via UI
# - Using network_mode: host allows direct access to HA on localhost
